{
  "name": "@fdr/landing",
  "version": "0.0.1",
  "private": true,
  "description": "Food & Drink Randomizer is a web application that helps you decide what to eat or drink by randomly selecting from a list of options.",
  "keywords": [
    "fdr",
    "food-drink",
    "randomizer"
  ],
  "homepage": "https://hieudoanm.github.io/fdr",
  "bugs": {
    "url": "https://github.com/hieudoanm/fdr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/hieudoanm/fdr.git"
  },
  "license": "MIT",
  "author": {
    "name": "hieudoanm",
    "email": "hieu.doan.professional@gmail.com",
    "url": "https://hieudoanm.github.io"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --cache --write .",
    "test": "jest --passWithNoTests",
    "predev": "rimraf .next && kill-port 3000",
    "dev": "next dev --turbopack",
    "prebuild": "rimraf .next out",
    "build": "next build",
    "prestart": "kill-port 3000",
    "start": "serve out -l 3000",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "foods:convert": "node scripts/csv-to-json.mjs"
  },
  "dependencies": {
    "@tailwindcss/typography": "0.5.20",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "daisyui": "5.8.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "kill-port": "2.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rimraf": "6.1.4",
    "serve": "14.2.8",
    "tailwindcss": "4.3.5",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
