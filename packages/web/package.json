{
  "name": "@fdr/web",
  "version": "0.0.1",
  "private": true,
  "description": "Food & Drink Randomizer is a web application that helps you decide what to eat or drink by randomly selecting from a list of options.",
  "keywords": [
    "fdr",
    "food-drink",
    "randomizer"
  ],
  "homepage": "https://hieudoanm.github.io/fdr",
  "bugs": {
    "url": "https://github.com/hieudoanm/fdr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/hieudoanm/fdr.git"
  },
  "license": "GPL-3.0",
  "author": {
    "name": "hieudoanm",
    "email": "hieu.doan.professional@gmail.com",
    "url": "https://hieudoanm.github.io"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "lint": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --cache --write .",
    "test": "jest --passWithNoTests",
    "predev": "rimraf .next && kill-port 3000",
    "dev": "next dev --turbopack",
    "prebuild": "rimraf .next out",
    "build": "next build",
    "prestart": "kill-port 3000",
    "start": "next start",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "foods:convert": "node scripts/foods-csv-to-json.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.106.1",
    "idb": "8.0.4",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "daisyui": "5.7.50",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "fake-indexeddb": "6.2.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "kill-port": "2.0.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rimraf": "6.1.4",
    "tailwindcss": "4.3.5",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
